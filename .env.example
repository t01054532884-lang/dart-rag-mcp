# opendart.fss.or.kr 에서 발급받은 40자리 인증키
DART_API_KEY=
# 선택: 에이전트 데모·평가에만 필요 (MCP 서버·검색은 키 없이 동작)
ANTHROPIC_API_KEY=
# 선택: 임베딩 모델 (기본 intfloat/multilingual-e5-large 2.2GB, 색인에 CPU로 약 2시간 반)
# 빠르게 해 보려면: EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# 선택: 하이브리드 검색에서 BM25 쪽 가중치 (기본 0.7)
# HYBRID_BM25_WEIGHT=0.7
